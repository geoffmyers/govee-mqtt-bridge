# Govee account credentials — the same login the iOS/Android app uses, NOT a
# Govee Developer API key (that API does not expose H5054 leak sensors at
# all). See "Govee account setup" in README.md for GOVEE_CLIENT_ID.
GOVEE_EMAIL=you@example.com
GOVEE_PASSWORD=your-govee-password
GOVEE_CLIENT_ID=your-registered-govee-client-id

# MQTT broker the bridge publishes to, and the credentials it connects with.
MQTT_HOST=mqtt.example.com
MQTT_PORT=1883
MQTT_USER=your-mqtt-username
MQTT_PASSWORD=your-mqtt-password

# Bridge behaviour
POLL_INTERVAL=30
LEAK_HOLD_SECONDS=600
HA_DISCOVERY_PREFIX=homeassistant
MQTT_TOPIC_PREFIX=govee/leak
LOG_LEVEL=INFO

# Optional: report uncaught exceptions to a GitHub repo via repository_dispatch
# (see infrastructure/_shared/python-github-error-reporter). Leave both unset
# to disable — this is off by default.
GITHUB_ERROR_TOKEN=
GITHUB_REPO=
GITHUB_ERROR_ENVIRONMENT=production
